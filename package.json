{
  "name": "uptodate",
  "displayName": "UptoDate",
  "description": "Prevent outdated pushes with smart branch sync checks before every Git push.",
  "version": "0.0.2",
  "publisher": "ManishRegmi",
  "license": "MIT",
  "icon": "images/img.png",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManishRegmi/upto.git"
  },
  "homepage": "https://github.com/ManishRegmi/upto#readme",
  "bugs": {
    "url": "https://github.com/ManishRegmi/upto/issues"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:upto.push",
    "onCommand:upto.track",
    "onCommand:upto.trackedBranches.view",
    "onCommand:upto.trackedBranches.add",
    "onCommand:upto.trackedBranches.remove",
    "onCommand:upto.status"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "upto.push",
        "title": "UpTo: Push"
      },
      {
        "command": "upto.track",
        "title": "UpTo: Track Branches"
      },
      {
        "command": "upto.trackedBranches.view",
        "title": "UpTo: View Tracked Branches"
      },
      {
        "command": "upto.trackedBranches.add",
        "title": "UpTo: Add Tracked Branches"
      },
      {
        "command": "upto.trackedBranches.remove",
        "title": "UpTo: Remove Tracked Branches"
      },
      {
        "command": "upto.status",
        "title": "UpTo: Status"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "upto.push",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "build": "node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "simple-git": "^3.36.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
